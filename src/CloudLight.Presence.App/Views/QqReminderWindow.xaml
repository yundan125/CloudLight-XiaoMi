<Window x:Class="CloudLight.Presence.App.Views.QqReminderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QQ 提醒 · CloudLight XiaoMi" Icon="/CloudLight.XiaoMi;component/Assets/CloudLightPresence.ico" Width="760" Height="900" MinHeight="650" Background="#F5F7FB" WindowStartupLocation="CenterOwner" Loaded="WindowLoaded">
  <Window.Resources><Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Foreground" Value="#B42318"/><Setter Property="Background" Value="#FEF0EF"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FEE2E0"/></Trigger></Style.Triggers></Style></Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
    <TextBlock Text="QQ 提醒" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="CloudLight XiaoMi 的 QQ 通知、自动提醒和系统提醒" Foreground="#64748B" Margin="0,7,0,0"/>
    <TextBlock Text="QQ 服务" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
    <Border Style="{StaticResource SurfaceCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="QQ Bot" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="状态：" Foreground="#64748B"/><TextBlock Text="{Binding QqStatusText}" FontWeight="SemiBold"/><TextBlock Text=" · " Foreground="#94A3B8"/><TextBlock Text="{Binding QqStatusDetail}" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="350"/></StackPanel><TextBlock Text="{Binding QqSecretText, StringFormat=应用密钥：{0}}" Foreground="#64748B" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="配置 QQ" Click="ConfigureQqClicked"/><Button Content="发送测试消息" Style="{StaticResource SecondaryButton}" Click="SendTestMessageClicked"/></StackPanel></Grid><TextBlock Text="使用 QQ 官方开放平台 Bot；私聊和群聊目标填写 OpenID，不会把认证密钥写入设置或导出文件。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="{Binding OperationStatus}" Foreground="#16803A" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
    <TextBlock Text="自动提醒" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/><Border Style="{StaticResource SurfaceCard}"><StackPanel><DockPanel Margin="0,0,0,14"><TextBlock Text="当主体持续处于指定状态时发送一次 QQ 提醒。" Foreground="#64748B"/><Button DockPanel.Dock="Right" Content="＋ 添加提醒" Click="AddRuleClicked" Padding="12,6"/></DockPanel><ItemsControl ItemsSource="{Binding Rules}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E4E9F0" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding MessagePreview}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="{Binding ToggleText}" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding}" Click="ToggleRuleClicked" Padding="10,5"/><Button Content="编辑" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding}" Click="EditRuleClicked" Padding="10,5"/><Button Content="删除" Style="{StaticResource DangerButton}" CommandParameter="{Binding}" Click="DeleteRuleClicked" Padding="10,5"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="暂无自动提醒。" Foreground="#94A3B8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasRules}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
    <TextBlock Text="连接异常提醒" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/><Border Style="{StaticResource SurfaceCard}"><StackPanel><CheckBox x:Name="ConnectionAlertEnabledBox" Content="Xiaomi 服务连接失败时通知"/><CheckBox x:Name="ConnectionAlertRecoveryBox" Content="恢复连接时通知" Margin="0,8,0,0"/><CheckBox x:Name="ConnectionAlertUseDefaultBox" Content="使用 QQ 配置中的默认接收目标" Margin="0,8,0,0" Checked="ConnectionAlertTargetModeChanged" Unchecked="ConnectionAlertTargetModeChanged"/><Grid x:Name="ConnectionAlertTargetGrid" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="发送到" Foreground="#64748B" VerticalAlignment="Center"/><ComboBox x:Name="ConnectionAlertTargetTypeBox" Grid.Column="1" SelectionChanged="ConnectionAlertTargetChanged"><ComboBoxItem Content="QQ 私聊" Tag="Private"/><ComboBoxItem Content="QQ群聊" Tag="Group"/></ComboBox><StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock x:Name="ConnectionAlertTargetLabel" Text="用户 OpenID" Foreground="#64748B" Margin="0,0,0,4"/><TextBox x:Name="ConnectionAlertTargetIdBox" ToolTip="不是普通 QQ 号，例如不要填写 123456789"/></StackPanel></Grid><TextBlock x:Name="ConnectionAlertTargetHint" Foreground="#64748B" TextWrapping="Wrap" Margin="130,8,0,0"/><Button Content="保存连接提醒设置" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="SaveConnectionAlertClicked" Padding="12,6"/></StackPanel></Border>
    <TextBlock Text="最近通知" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/><Border Style="{StaticResource SurfaceCard}"><StackPanel><ItemsControl ItemsSource="{Binding RecentDeliveries}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CreatedText}" Foreground="#64748B"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding SubjectName}" FontWeight="SemiBold"/><TextBlock Text="{Binding MessageText}" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorText}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" HorizontalAlignment="Right"/><TextBlock Text="{Binding TargetText}" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding RecentSystemDeliveries}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CreatedText}" Foreground="#64748B"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding SubjectName}" FontWeight="SemiBold"/><TextBlock Text="{Binding MessageText}" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorText}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" HorizontalAlignment="Right"/><TextBlock Text="{Binding TargetText}" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="暂无通知记录。" Foreground="#94A3B8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAnyRecentDeliveries}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
  </StackPanel></ScrollViewer>
</Window>
