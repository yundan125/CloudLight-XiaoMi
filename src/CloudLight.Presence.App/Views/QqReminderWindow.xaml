<UserControl x:Class="CloudLight.Presence.App.Views.QqReminderWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:CloudLight.Presence.App.Behaviors"
             Background="{DynamicResource WindowBackgroundBrush}"
             Loaded="WindowLoaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel Margin="{DynamicResource PagePadding}">
      <TextBlock Text="QQ 提醒" Style="{DynamicResource PageTitleStyle}"/>
      <TextBlock Text="管理 QQ Bot、联系人、自动提醒和发送记录。" Style="{DynamicResource PageSubtitleStyle}" Margin="0,7,0,0"/>

      <TextBlock Text="QQ 服务" Style="{DynamicResource SectionTitleStyle}" Margin="0,26,0,11"/>
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="QQ Bot" Style="{DynamicResource CardTitleStyle}"/>
                <Border Style="{DynamicResource StatusBadgeStyle}" Background="{Binding QqStatusBackgroundBrush}" Margin="12,0,0,0">
                  <TextBlock Text="{Binding QqStatusText}" Foreground="{Binding QqStatusBrush}"/>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding QqStatusDetail}" Style="{DynamicResource MutedTextStyle}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding QqSecretText, StringFormat=应用密钥：{0}}" Style="{DynamicResource MutedTextStyle}" Margin="0,5,0,0"/>
              <TextBlock Text="{Binding CurrentBotText}" Style="{DynamicResource MutedTextStyle}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Content="配置 QQ" Click="ConfigureQqClicked" Style="{DynamicResource PrimaryButtonStyle}"/>
              <Button Content="发送测试消息" Click="SendTestMessageClicked" Style="{DynamicResource SecondaryButtonStyle}"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="使用 QQ 官方开放平台 Bot；私聊和群聊目标填写 OpenID，不会把认证密钥写入设置或导出文件。" Style="{DynamicResource MutedTextStyle}" Margin="0,16,0,0"/>
          <TextBlock Text="{Binding BotSwitchText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding OperationStatus}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Grid Margin="0,26,0,11">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="QQ 联系人 / 接收目标" Style="{DynamicResource SectionTitleStyle}"/>
        <Button Grid.Column="1" Content="＋ 添加联系人" Click="AddRecipientClicked" Style="{DynamicResource PrimaryButtonStyle}" Padding="12,7" Margin="0"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding Recipients}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="300" MinHeight="166" Style="{DynamicResource CardStyle}" Margin="0,0,14,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding Note}" Style="{DynamicResource CardTitleStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                <StackPanel Grid.Row="1" Margin="0,8,0,8">
                  <TextBlock Text="{Binding Summary}" Style="{DynamicResource MutedTextStyle}"/>
                  <TextBlock Text="{Binding CurrentBotAppIdText, StringFormat=当前 Bot AppID：{0}}" Foreground="{DynamicResource SubtleBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                  <TextBlock Text="{Binding HistoricalBindingCount, StringFormat=历史 Bot 绑定：{0}}" Foreground="{DynamicResource SubtleBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                  <Button Content="测试" Click="TestRecipientClicked" CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Padding="10,6"/>
                  <Button Content="编辑" Click="EditRecipientClicked" CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Padding="10,6"/>
                  <Button Content="绑定管理" Click="ManageRecipientBindingsClicked" CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Padding="10,6"/>
                  <Button Content="删除" Click="DeleteRecipientClicked" CommandParameter="{Binding}" Style="{DynamicResource DangerButton}" Padding="10,6" Margin="0"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Margin="0,0,0,8">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="24"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasRecipients}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="还没有 QQ 接收人" Style="{DynamicResource CardTitleStyle}" HorizontalAlignment="Center"/>
          <TextBlock Text="保存常用 OpenID 后，添加提醒和测试消息时可以直接选择。" Style="{DynamicResource MutedTextStyle}" Margin="0,7,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"/>
          <Button Content="添加第一个接收人" Click="AddRecipientClicked" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
      </Border>

      <TextBlock Text="自动提醒" Style="{DynamicResource SectionTitleStyle}" Margin="0,26,0,11"/>
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="＋ 添加提醒" Click="AddRuleClicked" Style="{DynamicResource PrimaryButtonStyle}" Padding="12,7" Margin="0"/>
            <TextBlock Text="当主体连续在线/离线，或确认检测到上线/离线时发送一次 QQ 提醒。" Style="{DynamicResource MutedTextStyle}" VerticalAlignment="Center"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Rules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SubjectName}" Style="{DynamicResource CardTitleStyle}"/><Border Style="{DynamicResource StatusBadgeStyle}" Background="{DynamicResource SuccessSoftBrush}" Margin="10,0,0,0"><TextBlock Text="{Binding EnabledText}" Foreground="{DynamicResource SuccessBrush}"/></Border><Border Style="{DynamicResource StatusBadgeStyle}" Background="{DynamicResource CardBrush}" Margin="8,0,0,0"><TextBlock Text="{Binding DiagnosticTitle}" Foreground="{Binding DiagnosticColor}"/></Border></StackPanel>
                      <TextBlock Text="{Binding ConditionText}" Foreground="{DynamicResource TextBrush}" Margin="0,7,0,0"/>
                      <TextBlock Text="{Binding TargetText, StringFormat=发送到：{0}}" Style="{DynamicResource MutedTextStyle}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetText}"/>
                      <TextBlock Text="{Binding MessagePreview}" Style="{DynamicResource MutedTextStyle}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding MessagePreview}"/>
                      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,11,0,0">
                        <StackPanel>
                          <TextBlock Text="{Binding DiagnosticText}" Foreground="{Binding DiagnosticColor}" TextWrapping="Wrap"/>
                          <StackPanel>
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasProgress}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="{Binding CurrentStateText}" Style="{DynamicResource MutedTextStyle}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CurrentDurationText}" Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ProgressText}" Style="{DynamicResource MutedTextStyle}" Margin="0,4,0,0"/>
                          </StackPanel>
                          <TextBlock Text="{Binding LastEvaluationText}" Style="{DynamicResource MutedTextStyle}" Margin="0,8,0,0"/>
                          <TextBlock Text="{Binding LastTriggeredText}" Style="{DynamicResource MutedTextStyle}" Margin="0,3,0,0"/>
                          <TextBlock Text="{Binding LastSentText}" Style="{DynamicResource MutedTextStyle}" Margin="0,3,0,0"/>
                          <TextBlock Text="{Binding LastErrorText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                      <Button Content="{Binding ToggleText}" Style="{DynamicResource SecondaryButtonStyle}" CommandParameter="{Binding}" Click="ToggleRuleClicked" Padding="10,6"/>
                      <Button Content="编辑" Style="{DynamicResource SecondaryButtonStyle}" CommandParameter="{Binding}" Click="EditRuleClicked" Padding="10,6"/>
                      <Button Content="检查规则" Style="{DynamicResource SecondaryButtonStyle}" CommandParameter="{Binding}" Click="CheckRuleClicked" Padding="10,6"/>
                      <Button Content="删除" Style="{DynamicResource DangerButton}" CommandParameter="{Binding}" Click="DeleteRuleClicked" Padding="10,6" Margin="0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border>
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
                <Setter Property="Padding" Value="20"/>
                <Style.Triggers><DataTrigger Binding="{Binding HasRules}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="还没有自动提醒" Style="{DynamicResource CardTitleStyle}" HorizontalAlignment="Center"/>
              <TextBlock Text="为 Presence 主体设置条件后，通知会在这里显示。" Style="{DynamicResource MutedTextStyle}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
              <Button Content="添加第一个提醒" Click="AddRuleClicked" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock Text="连接异常提醒" Style="{DynamicResource SectionTitleStyle}" Margin="0,26,0,11"/>
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel>
          <CheckBox x:Name="ConnectionAlertEnabledBox" Content="Xiaomi 服务连接失败时通知" Style="{DynamicResource ToggleSwitchStyle}"/>
          <CheckBox x:Name="ConnectionAlertRecoveryBox" Content="恢复连接时通知" Style="{DynamicResource ToggleSwitchStyle}" Margin="0,14,0,0"/>
          <CheckBox x:Name="ConnectionAlertUseDefaultBox" Content="使用 QQ 配置中的默认接收人" Style="{DynamicResource ToggleSwitchStyle}" Margin="0,14,0,0" Checked="ConnectionAlertTargetModeChanged" Unchecked="ConnectionAlertTargetModeChanged"/>
          <TextBlock Text="选择连接提醒接收人" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,18,0,7"/>
          <Border>
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers><DataTrigger Binding="{Binding HasRecipients}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <ListBox x:Name="ConnectionAlertRecipientsList" ItemsSource="{Binding Recipients}" SelectionMode="Multiple" MaxHeight="220" Style="{DynamicResource ListBoxStyle}" ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Auto" behaviors:NestedScrollBehavior.BubbleMouseWheelAtBoundary="True">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Note}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary, StringFormat= · {0}}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Border>
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/><Setter Property="Padding" Value="18"/><Style.Triggers><DataTrigger Binding="{Binding HasRecipients}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel HorizontalAlignment="Center"><TextBlock Text="还没有可选联系人" Style="{DynamicResource CardTitleStyle}" HorizontalAlignment="Center"/><TextBlock Text="先保存 QQ 接收人，才能为连接异常选择目标。" Style="{DynamicResource MutedTextStyle}" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
          </Border>
          <TextBlock Text="未选择联系人时，请使用 QQ 配置中的默认接收人。" Style="{DynamicResource MutedTextStyle}" Margin="0,7,0,0"/>
          <Button Content="保存连接提醒设置" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Right" Margin="0,14,0,0" Click="SaveConnectionAlertClicked" Padding="12,7"/>
        </StackPanel>
      </Border>

      <TextBlock Text="最近发送" Style="{DynamicResource SectionTitleStyle}" Margin="0,26,0,11"/>
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding RecentDeliveries}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding CreatedText}" Style="{DynamicResource MutedTextStyle}"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="{Binding SubjectName}" FontWeight="SemiBold"/><TextBlock Text="{Binding MessageText}" Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" HorizontalAlignment="Right"/><TextBlock Text="{Binding TargetText}" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetText}"/><TextBlock Text="{Binding BotText}" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding RecentSystemDeliveries}" Margin="0,2,0,0">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding CreatedText}" Style="{DynamicResource MutedTextStyle}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding SubjectName}" FontWeight="SemiBold"/><TextBlock Text="{Binding MessageText}" Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" HorizontalAlignment="Right"/><TextBlock Text="{Binding TargetText}" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/><TextBlock Text="{Binding BotText}" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border>
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
                <Setter Property="Padding" Value="20"/>
                <Style.Triggers><DataTrigger Binding="{Binding HasAnyRecentDeliveries}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="还没有发送记录" Style="{DynamicResource CardTitleStyle}" HorizontalAlignment="Center"/>
              <TextBlock Text="测试消息和自动提醒的发送结果会显示在这里。" Style="{DynamicResource MutedTextStyle}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
