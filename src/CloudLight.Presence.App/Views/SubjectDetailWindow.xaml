<UserControl x:Class="CloudLight.Presence.App.Views.SubjectDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:CloudLight.Presence.App.Behaviors"
        xmlns:controls="clr-namespace:CloudLight.Presence.App.Controls"
        Background="{DynamicResource WindowBackgroundBrush}" SizeChanged="WindowSizeChanged">
  <UserControl.Resources>
    <Style x:Key="EditIconButton" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="6"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="ToolTip" Value="修改"/><Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Trigger></Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel Margin="{DynamicResource PagePadding}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <Button Content="← 设备" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.ReturnToDevicesCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,12"/>
          <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource PageTitleStyle}"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding StateMark}" Foreground="{Binding StateColor}" Margin="0,0,7,0"/><TextBlock Text="{Binding Duration}" FontWeight="SemiBold"/></StackPanel>
          <TextBlock Text="{Binding CurrentConnection}" Style="{DynamicResource MutedTextStyle}" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="拆分主体" Style="{StaticResource SecondaryButton}" Click="SplitClicked"/>
          <Button Content="解散主体" Style="{StaticResource DeleteButton}" Click="DeleteClicked"/>
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource SurfaceCard}" Margin="0,26,0,0">
        <Grid x:Name="InfoGrid">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="NamesPanel" Grid.Column="0">
            <TextBlock Text="名称 / 备注" Style="{DynamicResource CardTitleStyle}" Margin="0,0,0,18"/>
            <TextBlock Text="名称" Style="{DynamicResource FieldLabelStyle}"/>
            <Grid Margin="0,4,0,20">
              <Grid x:Name="NameBrowse"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsNameEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Style="{StaticResource EditIconButton}" Command="{Binding BeginNameEditCommand}"><Path Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z M20.71,7.04c.39-.39.39-1.02,0-1.41l-2.34-2.34a.9959.995,0,0,0-1.41,0l-1.83,1.83,3.75,3.75,1.83-1.83z" Fill="{DynamicResource MutedBrush}" Stretch="Uniform" Width="15" Height="15"/></Button>
              </Grid>
              <Grid x:Name="NameEdit"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsNameEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding NameDraft, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="✓" Style="{StaticResource EditIconButton}" ToolTip="保存名称" Command="{Binding SaveNameCommand}"/>
                <Button Grid.Column="2" Content="×" Style="{StaticResource EditIconButton}" ToolTip="取消" Command="{Binding CancelNameEditCommand}"/>
              </Grid>
            </Grid>
            <TextBlock Text="备注" Style="{DynamicResource FieldLabelStyle}"/>
            <Grid Margin="0,4,0,0">
              <Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsNoteEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding NoteText}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource EditIconButton}" Command="{Binding BeginNoteEditCommand}"><Path Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z M20.71,7.04c.39-.39.39-1.02,0-1.41l-2.34-2.34a.9959.995,0,0,0-1.41,0l-1.83,1.83,3.75,3.75,1.83-1.83z" Fill="{DynamicResource MutedBrush}" Stretch="Uniform" Width="15" Height="15"/></Button>
              </Grid>
              <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsNoteEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding NoteDraft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" MaxHeight="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <Button Grid.Column="1" Content="✓" Style="{StaticResource EditIconButton}" ToolTip="保存备注" VerticalAlignment="Bottom" Command="{Binding SaveNoteCommand}"/>
                <Button Grid.Column="2" Content="×" Style="{StaticResource EditIconButton}" ToolTip="取消" VerticalAlignment="Bottom" Command="{Binding CancelNoteEditCommand}"/>
              </Grid>
            </Grid>
          </StackPanel>

          <Border x:Name="MembersPanel" Grid.Column="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" Padding="24,0,0,0">
            <StackPanel>
              <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="关联设备" Style="{DynamicResource CardTitleStyle}"/>
                <Button Grid.Column="1" Content="管理" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0" Click="ManageClicked"/>
              </Grid>
              <Border Margin="0,12,0,2" Visibility="{Binding HasNoMembers, Converter={StaticResource BooleanToVisibility}}"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/></Style></Border.Style><TextBlock Text="还没有关联设备" Style="{DynamicResource MutedTextStyle}"/></Border>
              <ItemsControl ItemsSource="{Binding Members}" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Command="{Binding OpenCommand}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0,5" HorizontalContentAlignment="Stretch">
                      <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12">
                      <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Ellipse Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Width="8" Height="8" Fill="{Binding StateColor}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Signal}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Mac}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Connection}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Ip}" Foreground="{DynamicResource MutedBrush}"/>
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <TextBlock Text="最近在线情况" Style="{DynamicResource SectionTitleStyle}" Margin="0,28,0,12"/>
      <ItemsControl ItemsSource="{Binding Statistics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{DynamicResource SurfaceCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{Binding Label}" Style="{DynamicResource MutedTextStyle}"/><TextBlock Text="{Binding OnlineDuration}" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="{Binding OfflineDuration}" Style="{DynamicResource MutedTextStyle}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding UnknownDuration}" Style="{DynamicResource MutedTextStyle}" FontSize="11" Margin="0,2,0,0"/><TextBlock Text="{Binding Coverage}" Style="{DynamicResource MutedTextStyle}" FontSize="11" Margin="0,2,0,0"/><TextBlock Text="{Binding OnlinePercentage}" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0"/><TextBlock Text="{Binding CoverageDetail}" Style="{DynamicResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/><TextBlock Text="{Binding QualityWarning}" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

      <TextBlock Text="在线时间分布" Style="{DynamicResource SectionTitleStyle}" Margin="0,28,0,12"/>
      <Border Style="{DynamicResource SurfaceCard}"><StackPanel><StackPanel Orientation="Horizontal"><Button Content="24小时" Style="{DynamicResource FilterButton}" Command="{Binding Show24HoursCommand}" Tag="{Binding Is24HoursSelected}"/><Button Content="3天" Style="{DynamicResource FilterButton}" Command="{Binding Show3DaysCommand}" Tag="{Binding Is3DaysSelected}"/><Button Content="7天" Style="{DynamicResource FilterButton}" Command="{Binding Show7DaysCommand}" Tag="{Binding Is7DaysSelected}"/><Button Content="30天" Style="{DynamicResource FilterButton}" Command="{Binding Show30DaysCommand}" Tag="{Binding Is30DaysSelected}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,14,0,8"><TextBlock Text="■ 在线" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Text="■ 离线" Foreground="{DynamicResource SubtleBrush}" Margin="18,0,0,0"/><TextBlock Text="▧ 未监控" Foreground="{DynamicResource SubtleBrush}" Margin="18,0,0,0"/><TextBlock Text="▧ 用户暂停" Foreground="{DynamicResource AccentBrush}" Margin="18,0,0,0"/></StackPanel><controls:PresenceTimelineControl Segments="{Binding Timeline}" From="{Binding TimelineFrom}" To="{Binding TimelineTo}" Days="{Binding TimelineDays}"/></StackPanel></Border>

      <Grid Margin="0,28,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="最近活动" Style="{DynamicResource SectionTitleStyle}"/><CheckBox Grid.Column="1" Content="显示无记录时段" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding ShowUnrecordedPeriods}" VerticalAlignment="Center"/></Grid>
      <TextBlock Text="{Binding DetectedAfterGapExplanation}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,-4,0,10" Visibility="{Binding HasDetectedAfterGapActivities, Converter={StaticResource BooleanToVisibility}}"/>
      <Border Style="{DynamicResource SurfaceCard}" Margin="0,0,0,24">
        <Grid><TextBlock Text="暂时没有活动记录" Style="{DynamicResource MutedTextStyle}" Visibility="{Binding HasNoHistory, Converter={StaticResource BooleanToVisibility}}"/>
          <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" behaviors:NestedScrollBehavior.BubbleMouseWheelAtBoundary="True">
            <ItemsControl ItemsSource="{Binding History}" HorizontalContentAlignment="Stretch"><ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Timestamp}" Style="{DynamicResource MutedTextStyle}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding Mark}" Foreground="{Binding EventColor}" Margin="0,0,8,0"/><TextBlock Text="{Binding Event}" Foreground="{Binding EventColor}" FontWeight="SemiBold"/></StackPanel>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
