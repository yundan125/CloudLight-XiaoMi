<Window x:Class="CloudLight.Presence.App.Views.DeviceDetailWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CloudLight.Presence.App.Controls"
        Title="设备详情" Width="900" Height="820" MinWidth="720" MinHeight="620" Background="#F5F7FB" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32">
    <TextBlock Text="{Binding Title}" FontSize="29" FontWeight="SemiBold" Foreground="#172033"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding StateMark}" Foreground="{Binding StateColor}" Margin="0,0,7,0"/><TextBlock Text="{Binding Duration}" FontSize="15"/></StackPanel>
    <TextBlock Text="最近在线统计" Style="{StaticResource SectionTitle}" Margin="0,28,0,12"/>
    <ItemsControl ItemsSource="{Binding Statistics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SurfaceCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{Binding Label}" Foreground="#64748B"/><TextBlock Text="{Binding OnlineDuration}" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="{Binding OnlinePercentage}" Foreground="#475569" Margin="0,5,0,0"/><TextBlock Text="{Binding Coverage}" Foreground="#64748B" Margin="0,3,0,0"/><TextBlock Text="⚠ 部分时间无监控数据" Foreground="#D97706" FontSize="11" Margin="0,7,0,0" Visibility="{Binding HasGap, Converter={StaticResource BooleanToVisibility}}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="活动时间轴" Style="{StaticResource SectionTitle}" Margin="0,28,0,12"/>
    <Border Style="{StaticResource SurfaceCard}"><StackPanel><StackPanel Orientation="Horizontal"><Button Content="24小时" Style="{StaticResource FilterButton}" Command="{Binding Show24HoursCommand}"/><Button Content="3天" Style="{StaticResource FilterButton}" Command="{Binding Show3DaysCommand}"/><Button Content="7天" Style="{StaticResource FilterButton}" Command="{Binding Show7DaysCommand}"/><Button Content="30天" Style="{StaticResource FilterButton}" Command="{Binding Show30DaysCommand}"/><TextBlock Text="{Binding SelectedRange}" VerticalAlignment="Center" Foreground="#64748B" Margin="6,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,14,0,8"><TextBlock Text="■ 在线" Foreground="#22C55E"/><TextBlock Text="■ 离线" Foreground="#CBD5E1" Margin="18,0,0,0"/><TextBlock Text="▧ 未知 / 缺口" Foreground="#64748B" Margin="18,0,0,0"/></StackPanel><controls:PresenceTimelineControl Segments="{Binding Timeline}" From="{Binding TimelineFrom}" To="{Binding TimelineTo}" Days="{Binding TimelineDays}"/></StackPanel></Border>
    <TextBlock Text="最近事件" Style="{StaticResource SectionTitle}" Margin="0,28,0,12"/><Border Style="{StaticResource SurfaceCard}"><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Day}" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding Time}"/><TextBlock Grid.Column="2" Text="{Binding Event}" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
    <TextBlock Text="名称和备注" Style="{StaticResource SectionTitle}" Margin="0,28,0,12"/><Border Style="{StaticResource SurfaceCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="名称" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Grid.RowSpan="2" Content="保存" Command="{Binding SaveCommand}" Margin="14,0,0,0" VerticalAlignment="Bottom"/><TextBlock Grid.Row="1" Text="备注" VerticalAlignment="Top" Margin="0,15,0,0"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="68" AcceptsReturn="True" Margin="0,12,0,0"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SaveStatus}" Foreground="#16A34A" Margin="14,10,0,0" VerticalAlignment="Top" MaxWidth="180" TextWrapping="Wrap"/></Grid></Border>
    <Expander Header="设备详细信息" Margin="0,26,0,20" FontWeight="SemiBold"><Border Style="{StaticResource SurfaceCard}" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="MAC" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding Mac}"/><TextBlock Grid.Row="1" Text="IP" Foreground="#64748B"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Ip}"/><TextBlock Grid.Row="2" Text="连接 / 信号" Foreground="#64748B"/><TextBlock Grid.Row="2" Grid.Column="1"><Run Text="{Binding Connection, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Signal, Mode=OneWay}"/></TextBlock><TextBlock Grid.Row="3" Text="原始名称" Foreground="#64748B"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OriginalName}"/><TextBlock Grid.Row="4" Text="Cloud 名称" Foreground="#64748B"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OriginName}"/><TextBlock Grid.Row="5" Text="首次发现" Foreground="#64748B"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FirstSeen}"/><TextBlock Grid.Row="6" Text="最近 Cloud Seen" Foreground="#64748B"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastSeen}"/><TextBlock Grid.Row="7" Text="最近状态变化" Foreground="#64748B"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LastChanged}"/><TextBlock Grid.Row="8" Text="Router" Foreground="#64748B"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding RouterText}"/></Grid></Border></Expander>
  </StackPanel></ScrollViewer>
</Window>
