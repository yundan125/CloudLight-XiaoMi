<UserControl x:Class="CloudLight.Presence.App.Views.DeviceDetailWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:CloudLight.Presence.App.Behaviors"
             xmlns:controls="clr-namespace:CloudLight.Presence.App.Controls"
             Background="{DynamicResource WindowBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel Margin="{DynamicResource PagePadding}">
      <Button Content="← 设备" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding DataContext.ReturnToDevicesCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
      <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleStyle}" TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding StateMark}" Foreground="{Binding StateColor}" Margin="0,0,8,0"/><TextBlock Text="{Binding State}" FontWeight="SemiBold"/><TextBlock Text="{Binding Duration}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"/></StackPanel>

      <TextBlock Text="最近在线情况" Style="{DynamicResource SectionTitleStyle}" Margin="0,28,0,12"/>
      <ItemsControl ItemsSource="{Binding Statistics}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="{Binding Label}" Style="{DynamicResource MutedTextStyle}"/>
              <TextBlock Text="在线" Style="{DynamicResource MutedTextStyle}" FontSize="11" Margin="0,9,0,0"/>
              <TextBlock Text="{Binding OnlineDuration}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding OfflineDuration}" Style="{DynamicResource MutedTextStyle}" FontSize="11" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding UnknownDuration}" Style="{DynamicResource MutedTextStyle}" FontSize="11" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding Coverage}" Style="{DynamicResource MutedTextStyle}" FontSize="11" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding OnlinePercentage}" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0"/>
              <TextBlock Text="{Binding CoverageDetail}" Style="{DynamicResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding QualityWarning}" Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="在线时间分布" Style="{DynamicResource SectionTitleStyle}" Margin="0,28,0,12"/>
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Button Content="24小时" Style="{DynamicResource FilterButton}" Command="{Binding Show24HoursCommand}" Tag="{Binding Is24HoursSelected}"/><Button Content="3天" Style="{DynamicResource FilterButton}" Command="{Binding Show3DaysCommand}" Tag="{Binding Is3DaysSelected}"/><Button Content="7天" Style="{DynamicResource FilterButton}" Command="{Binding Show7DaysCommand}" Tag="{Binding Is7DaysSelected}"/><Button Content="30天" Style="{DynamicResource FilterButton}" Command="{Binding Show30DaysCommand}" Tag="{Binding Is30DaysSelected}"/><TextBlock Text="{Binding SelectedRange}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0"/></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,8"><TextBlock Text="■ 在线" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Text="■ 离线" Foreground="{DynamicResource SubtleBrush}" Margin="18,0,0,0"/><TextBlock Text="▧ 未监控" Foreground="{DynamicResource SubtleBrush}" Margin="18,0,0,0"/><TextBlock Text="▧ 用户暂停" Foreground="{DynamicResource AccentBrush}" Margin="18,0,0,0"/></StackPanel>
          <controls:PresenceTimelineControl Segments="{Binding Timeline}" From="{Binding TimelineFrom}" To="{Binding TimelineTo}" Days="{Binding TimelineDays}"/>
        </StackPanel>
      </Border>

      <TextBlock Text="最近活动" Style="{DynamicResource SectionTitleStyle}" Margin="0,28,0,12"/>
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel>
          <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" behaviors:NestedScrollBehavior.BubbleMouseWheelAtBoundary="True">
            <ItemsControl ItemsSource="{Binding History}" HorizontalContentAlignment="Stretch">
              <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp}" Style="{DynamicResource MutedTextStyle}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding Mark}" Foreground="{Binding EventColor}" Margin="0,0,8,0"/><TextBlock Text="{Binding Event}" Foreground="{Binding EventColor}" FontWeight="SemiBold"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border>
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock Text="还没有活动记录" Style="{DynamicResource MutedTextStyle}"/>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock Text="名称和备注" Style="{DynamicResource SectionTitleStyle}" Margin="0,28,0,12"/>
      <Border Style="{DynamicResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="名称" Style="{DynamicResource FieldLabelStyle}"/>
          <TextBox Grid.Column="1" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"/>
          <Button Grid.Column="2" Grid.RowSpan="2" Content="保存" Command="{Binding SaveCommand}" Margin="14,0,0,0" VerticalAlignment="Bottom"/>
          <TextBlock Grid.Row="1" Text="备注" Style="{DynamicResource FieldLabelStyle}" Margin="0,15,0,0" VerticalAlignment="Top"/>
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MinHeight="76" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SaveStatus}" Foreground="{DynamicResource SuccessBrush}" Margin="14,10,0,0" VerticalAlignment="Top" MaxWidth="180" TextWrapping="Wrap"/>
        </Grid>
      </Border>

      <Expander Header="设备详细信息" Style="{DynamicResource CloudLightExpanderStyle}" Margin="0,26,0,20">
        <Border Style="{DynamicResource CardStyle}" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="MAC" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Column="1" Text="{Binding Mac}"/>
            <TextBlock Grid.Row="1" Text="IP" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Ip}"/>
            <TextBlock Grid.Row="2" Text="连接 / 信号" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="2" Grid.Column="1"><Run Text="{Binding Connection, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Signal, Mode=OneWay}"/></TextBlock>
            <TextBlock Grid.Row="3" Text="设备原始名称" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OriginalName}"/>
            <TextBlock Grid.Row="4" Text="路由器记录的名称" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OriginName}"/>
            <TextBlock Grid.Row="5" Text="首次发现" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FirstSeen}"/>
            <TextBlock Grid.Row="6" Text="最近发现" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastSeen}"/>
            <TextBlock Grid.Row="7" Text="最近状态变化" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LastChanged}"/>
            <TextBlock Grid.Row="8" Text="所属路由器" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding RouterText}"/>
          </Grid>
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
