<UserControl x:Class="CloudLight.Presence.App.Views.XiaomiAccountDeviceDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F5F7FB">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding StatusMark}" Foreground="{Binding StatusColor}" FontSize="20" Margin="0,0,9,0"/>
          <TextBlock Text="{Binding Name}" FontSize="29" FontWeight="SemiBold" Foreground="#172033" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
          <TextBlock Text=" · " Foreground="#94A3B8"/>
          <TextBlock Text="{Binding LocationText}" Foreground="#64748B"/>
          <TextBlock Text=" · " Foreground="#94A3B8"/>
          <TextBlock Text="{Binding ModelText}" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </StackPanel>
      <Button x:Name="ReturnToDevicesButton" Grid.Column="1" Content="返回设备" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.ReturnToDevicesCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="0"/>
    </Grid>

    <Border Grid.Row="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,20,0,0" Visibility="{Binding IsOffline, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock Text="{Binding OfflineHint}" Foreground="#9A3412" TextWrapping="Wrap"/>
    </Border>

    <Grid Grid.Row="2" Margin="0,18,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding CapabilitySummary}" Foreground="#64748B" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="刷新能力" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="12,0,0,0"/>
    </Grid>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="设备状态" Style="{StaticResource SectionTitle}" Margin="0,8,0,12"/>
        <Border Style="{StaticResource SurfaceCard}">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Services}" Visibility="{Binding HasReadableProperties, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,16" Visibility="{Binding HasReadableProperties, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding ReadableProperties}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}" Foreground="#475569"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentValueText}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding UnitText}" Foreground="#64748B" HorizontalAlignment="Left"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="暂无可读取状态" Foreground="#64748B" Visibility="{Binding HasNoReadableProperties, Converter={StaticResource BooleanToVisibility}}"/>
          </StackPanel>
        </Border>

        <TextBlock Text="设备控制" Style="{StaticResource SectionTitle}" Margin="0,28,0,12"/>
        <Border Style="{StaticResource SurfaceCard}">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding WritableProperties}" Visibility="{Binding HasWritableProperties, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4,0,13">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding OperationText}" Foreground="#64748B" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <CheckBox Content="{Binding BooleanControlText}" IsChecked="{Binding BoolValue, Mode=OneWay}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanOperate}" VerticalAlignment="Center" Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibility}}"/>
                      <StackPanel Orientation="Horizontal" Visibility="{Binding IsEnum, Converter={StaticResource BooleanToVisibility}}">
                        <ComboBox Width="190" ItemsSource="{Binding ValueOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedOption, Mode=TwoWay}" IsEnabled="{Binding CanOperate}"/>
                        <Button Content="应用" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanOperate}" Padding="11,6" Margin="8,0,0,0"/>
                      </StackPanel>
                      <StackPanel Visibility="{Binding IsNumber, Converter={StaticResource BooleanToVisibility}}" MinWidth="300">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                          <Slider Minimum="{Binding MinimumDouble}" Maximum="{Binding MaximumDouble}" Value="{Binding SliderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="{Binding StepDouble}" IsSnapToTickEnabled="True" IsEnabled="{Binding CanOperate}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding DraftNumberText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                          <TextBlock Text="{Binding UnitText}" Foreground="#64748B" VerticalAlignment="Center"/>
                          <Button Content="应用" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanOperate}" Padding="11,5" Margin="10,0,0,0"/>
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Visibility="{Binding IsString, Converter={StaticResource BooleanToVisibility}}">
                        <TextBox Width="220" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanOperate}"/>
                        <Button Content="保存" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanOperate}" Padding="11,6" Margin="8,0,0,0"/>
                      </StackPanel>
                      <TextBlock Text="此类型暂不支持编辑" Foreground="#64748B" Visibility="{Binding IsUnsupportedEditor, Converter={StaticResource BooleanToVisibility}}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding DisabledText}" Foreground="#B45309" FontSize="12" VerticalAlignment="Center" MaxWidth="170" TextWrapping="Wrap" Margin="12,0,0,0"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding NoControlsText}" Foreground="#64748B" Visibility="{Binding HasNoWritableProperties, Converter={StaticResource BooleanToVisibility}}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock Text="更多操作" Style="{StaticResource SectionTitle}" Margin="0,28,0,12"/>
        <Border Style="{StaticResource SurfaceCard}">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Actions}" Visibility="{Binding HasActions, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ServiceName}" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Text=" · 含参数" Foreground="#64748B" FontSize="12" Visibility="{Binding HasInputArguments, Converter={StaticResource BooleanToVisibility}}"/>
                        <TextBlock Text=" · 需要二次确认" Foreground="#B45309" FontSize="12" Visibility="{Binding RequiresConfirmation, Converter={StaticResource BooleanToVisibility}}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding OperationText}" Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding DisplayName}" Command="{Binding ExecuteCommand}" IsEnabled="{Binding CanOperate}" Padding="12,6" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="暂无更多操作" Foreground="#64748B" Visibility="{Binding HasNoActions, Converter={StaticResource BooleanToVisibility}}"/>
          </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding HasEvents, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Text="支持的事件" Style="{StaticResource SectionTitle}" Margin="0,28,0,12"/>
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel>
              <TextBlock Text="事件仅作为设备能力信息展示，不会伪造成可执行按钮。" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}"/><TextBlock Grid.Column="1" Text="{Binding ServiceName}" Foreground="#64748B"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBlock Text="{Binding DiagnosticMessage}" Foreground="#B45309" Margin="0,16,0,0" TextWrapping="Wrap"/>

        <Expander Header="高级设备信息" Margin="0,26,0,20" FontWeight="SemiBold">
          <Border Style="{StaticResource SurfaceCard}" Margin="0,10,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="型号" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding ModelText}"/>
                <TextBlock Grid.Row="1" Text="设备 ID" Foreground="#64748B"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Device.Did}"/>
                <TextBlock Grid.Row="2" Text="Spec 类型" Foreground="#64748B"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Device.SpecType}"/>
                <TextBlock Grid.Row="3" Text="服务数量" Foreground="#64748B"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Services.Count}"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding Services}" Margin="0,17,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                      <TextBlock Text="{Binding TechnicalText}" Foreground="#64748B"/>
                      <ItemsControl ItemsSource="{Binding AllProperties}" Margin="12,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding TechnicalText}" Foreground="#64748B" FontSize="12" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      <ItemsControl ItemsSource="{Binding Actions}" Margin="12,2,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding TechnicalText}" Foreground="#64748B" FontSize="12" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      <ItemsControl ItemsSource="{Binding Events}" Margin="12,2,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding TechnicalText}" Foreground="#64748B" FontSize="12" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
      <TextBlock Text="{Binding LoadingText}" Foreground="#64748B" TextWrapping="Wrap"/>
      <TextBlock Text=" · " Foreground="#94A3B8"/>
      <TextBlock Text="{Binding OperationStatus}" Foreground="#64748B" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
