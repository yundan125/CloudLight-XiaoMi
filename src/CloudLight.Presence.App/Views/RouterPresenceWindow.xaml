<UserControl x:Class="CloudLight.Presence.App.Views.RouterPresenceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F5F7FB">
  <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="路由器 Presence" FontSize="30" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="{Binding RouterSummary}" Foreground="#64748B" Margin="0,8,0,0"/></StackPanel><Button x:Name="ReturnToDevicesButton" Grid.Column="1" Content="返回设备" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.ReturnToDevicesCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/></Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,0"><TextBlock Text="Xiaomi：" Foreground="#64748B"/><TextBlock Text="{Binding CloudStatus}" FontWeight="SemiBold"/><TextBlock Text=" · " Foreground="#94A3B8"/><TextBlock Text="{Binding LastUpdateText, StringFormat=最近更新：{0}}" Foreground="#64748B"/><Button Content="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="14,0,0,0"/></StackPanel>
    <Grid Grid.Row="2" Margin="0,22,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Style="{StaticResource FilterButton}" Command="{Binding ShowAllCommand}"><TextBlock><Run Text="全部 "/><Run Text="{Binding AllCount, Mode=OneWay}"/></TextBlock></Button><Button Style="{StaticResource FilterButton}" Command="{Binding ShowOnlineCommand}"><TextBlock><Run Text="在线 "/><Run Text="{Binding OnlineCount, Mode=OneWay}"/></TextBlock></Button><Button Style="{StaticResource FilterButton}" Command="{Binding ShowOfflineCommand}"><TextBlock><Run Text="离线 "/><Run Text="{Binding OfflineCount, Mode=OneWay}"/></TextBlock></Button><Button Style="{StaticResource FilterButton}" Command="{Binding ShowUnknownCommand}"><TextBlock><Run Text="未知 "/><Run Text="{Binding UnknownCount, Mode=OneWay}"/></TextBlock></Button></StackPanel><TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索名称、备注、关联设备、MAC 或 IP"/></Grid>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding CardsView}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding OpenCommand}" Background="Transparent" Foreground="#172033" Padding="0" Margin="0,0,16,16" ToolTip="{Binding Secondary}" HorizontalContentAlignment="Stretch"><Border Width="300" MinHeight="174" Padding="20"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#AFC0F6"/><Setter Property="Background" Value="#FAFBFF"/></Trigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StateMark}" Foreground="{Binding StateColor}" FontSize="17" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="235"/></StackPanel><StackPanel Grid.Row="1" Margin="0,19,0,18"><TextBlock Text="{Binding Duration}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentConnection}" Foreground="#64748B" Margin="0,7,0,0"/></StackPanel><TextBlock Grid.Row="2" Text="{Binding Secondary}" Foreground="#475569"/></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <TextBlock Grid.Row="4" Text="{Binding DiagnosticMessage}" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
