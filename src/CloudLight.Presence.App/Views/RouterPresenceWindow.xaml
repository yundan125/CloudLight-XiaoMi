<UserControl x:Class="CloudLight.Presence.App.Views.RouterPresenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CloudLight.Presence.App.Controls"
             Background="{DynamicResource WindowBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel Margin="{DynamicResource PagePadding}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="路由器 Presence" Style="{DynamicResource PageTitleStyle}"/>
          <TextBlock Text="管理路由器网络设备、Presence 主体与在线历史。" Style="{DynamicResource PageSubtitleStyle}" Margin="0,7,0,0"/>
          <TextBlock Text="{Binding RouterSummary}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
        <Button x:Name="ReturnToDevicesButton" Grid.Column="1" Content="← 设备总览" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding DataContext.ReturnToDevicesCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
      </Grid>

      <WrapPanel Margin="0,20,0,0">
        <TextBlock Text="Xiaomi：" Foreground="{DynamicResource MutedBrush}"/>
        <TextBlock Text="{Binding CloudStatus}" FontWeight="SemiBold"/>
        <TextBlock Text=" · " Foreground="{DynamicResource SubtleBrush}"/>
        <TextBlock Text="{Binding LastUpdateText, StringFormat=最近更新：{0}}" Foreground="{DynamicResource MutedBrush}"/>
        <Button Content="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" Style="{DynamicResource SecondaryButtonStyle}" Padding="12,7" Margin="14,0,0,0"/>
      </WrapPanel>

      <Border Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="路由器兼容性" Style="{DynamicResource CardTitleStyle}"/>
          <TextBlock Text="{Binding RouterCompatibilityText}" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Model" Style="{DynamicResource FieldLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{Binding Router.MiotModel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Router.MiotModel}"/>
            <TextBlock Grid.Column="2" Text="DID" Style="{DynamicResource FieldLabelStyle}"/>
            <TextBlock Grid.Column="3" Text="{Binding RouterDidText}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="1" Text="partner_id" Style="{DynamicResource FieldLabelStyle}" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PartnerIdText}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="partner_id 状态" Style="{DynamicResource FieldLabelStyle}" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PartnerIdStatus}" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="2" Text="Endpoint" Style="{DynamicResource FieldLabelStyle}" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding RouterDiagnostic.Endpoint}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RouterDiagnostic.Endpoint}"/>
            <TextBlock Grid.Row="3" Text="客户端列表" Style="{DynamicResource FieldLabelStyle}" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ClientListStatus}" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="Presence" Style="{DynamicResource FieldLabelStyle}" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding PresenceStatus}" Margin="0,8,0,0"/>
          </Grid>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="最近 API code" Style="{DynamicResource FieldLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{Binding ApiCodeText}"/>
            <TextBlock Grid.Column="2" Text="最近成功" Style="{DynamicResource FieldLabelStyle}"/>
            <TextBlock Grid.Column="3" Text="{Binding LastSuccessText}"/>
            <TextBlock Grid.Row="1" Text="成功字段" Style="{DynamicResource FieldLabelStyle}" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SuccessfulFieldsText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </Grid>
        </StackPanel>
      </Border>

      <Grid Margin="0,22,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Style="{DynamicResource FilterButton}" Command="{Binding ShowAllCommand}" Tag="{Binding IsPresenceAllFilterActive}"><TextBlock><Run Text="全部 "/><Run Text="{Binding AllCount, Mode=OneWay}"/></TextBlock></Button>
          <Button Style="{DynamicResource FilterButton}" Command="{Binding ShowOnlineCommand}" Tag="{Binding IsPresenceOnlineFilterActive}"><TextBlock><Run Text="在线 "/><Run Text="{Binding OnlineCount, Mode=OneWay}"/></TextBlock></Button>
          <Button Style="{DynamicResource FilterButton}" Command="{Binding ShowOfflineCommand}" Tag="{Binding IsPresenceOfflineFilterActive}"><TextBlock><Run Text="离线 "/><Run Text="{Binding OfflineCount, Mode=OneWay}"/></TextBlock></Button>
          <Button Style="{DynamicResource FilterButton}" Command="{Binding ShowUnknownCommand}" Tag="{Binding IsPresenceUnknownFilterActive}"><TextBlock><Run Text="未知 "/><Run Text="{Binding UnknownCount, Mode=OneWay}"/></TextBlock></Button>
        </StackPanel>
        <TextBox Grid.Column="1" Style="{DynamicResource SearchInputStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="搜索 Presence" ToolTip="搜索名称、备注、关联设备、MAC 或 IP"/>
      </Grid>

      <Border>
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource EmptyStateCardStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding AllCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="还没有 Presence 主体" Style="{DynamicResource CardTitleStyle}" HorizontalAlignment="Center"/>
          <TextBlock Text="路由器完成一次发现后，主体卡片会显示在这里。" Style="{DynamicResource MutedTextStyle}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding CardsView}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ResponsiveWrapPanel MinItemWidth="300" ItemSpacing="16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding OpenCommand}" Background="Transparent" Foreground="{DynamicResource TextBrush}" Padding="0" Margin="0,0,0,16" ToolTip="{Binding Secondary}" HorizontalContentAlignment="Stretch">
              <Border MinHeight="174" Style="{DynamicResource CardHoverStyle}">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StateMark}" Foreground="{Binding StateColor}" FontSize="17" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,19,0,18"><TextBlock Text="{Binding Duration}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentConnection}" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel>
                  <TextBlock Grid.Row="2" Text="{Binding Secondary}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Secondary}"/>
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding DiagnosticMessage}" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,24" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
