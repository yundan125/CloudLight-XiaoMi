<UserControl x:Class="CloudLight.Presence.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel Margin="{DynamicResource PagePadding}">
      <TextBlock Text="关于" Style="{DynamicResource PageTitleStyle}"/>
      <TextBlock Text="了解 CloudLight XiaoMi 和当前运行环境。" Style="{DynamicResource PageSubtitleStyle}" Margin="0,7,0,0"/>
      <Border Style="{DynamicResource CardStyle}" Margin="0,26,0,0">
        <StackPanel>
          <TextBlock Text="CloudLight" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
          <TextBlock Text="XiaoMi" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,-2,0,0"/>
          <TextBlock x:Name="VersionText" Style="{DynamicResource MutedTextStyle}" Margin="0,14,0,0"/>
          <TextBlock Text="CloudLight XiaoMi 用于管理 Xiaomi 账号设备、路由器 Presence 和 QQ 自动提醒。设备历史与通知数据保存在本机，QQ AppSecret 由当前 Windows 用户的 DPAPI 保护。" Style="{DynamicResource MutedTextStyle}" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="更新" Style="{DynamicResource SectionTitleStyle}" Margin="0,26,0,11"/>
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel>
          <TextBlock Text="GitHub Release" Style="{DynamicResource CardTitleStyle}"/>
          <TextBlock Text="只检查公开 Release 信息，不会自动下载或替换程序。" Style="{DynamicResource MutedTextStyle}" Margin="0,7,0,0" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,14,0,0">
            <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdateClicked" Style="{DynamicResource PrimaryButtonStyle}"/>
            <Button x:Name="ViewUpdateButton" Content="查看更新" Click="ViewUpdateClicked" Style="{DynamicResource SecondaryButtonStyle}" Visibility="Collapsed"/>
          </WrapPanel>
          <TextBlock x:Name="UpdateStatusText" Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <TextBlock x:Name="LastUpdateCheckText" Style="{DynamicResource MutedTextStyle}" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="运行信息" Style="{DynamicResource SectionTitleStyle}" Margin="0,26,0,11"/>
      <Border Style="{DynamicResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="数据目录" Style="{DynamicResource MutedTextStyle}"/>
          <TextBlock Grid.Column="1" x:Name="DataPathText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock Grid.Row="1" Text="产品版本" Style="{DynamicResource MutedTextStyle}" Margin="0,14,0,0"/>
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProductVersionText" Foreground="{DynamicResource TextBrush}" Margin="0,14,0,0"/>
          <TextBlock Grid.Row="2" Text="许可证" Style="{DynamicResource MutedTextStyle}" Margin="0,14,0,0"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="沿用项目现有许可证；未在应用内覆盖声明。" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </Grid>
      </Border>
      <Button Content="打开数据目录" Click="OpenDataDirectoryClicked" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
