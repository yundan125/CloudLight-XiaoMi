<Window x:Class="CloudLight.Presence.App.Views.MainWindow"
        x:Name="MainWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CloudLight.Presence.App.Controls"
        xmlns:views="clr-namespace:CloudLight.Presence.App.Views"
        Title="{Binding MainWindowTitle}"
        Icon="/CloudLight.XiaoMi;component/Assets/CloudLightPresence.ico"
        Width="1200" Height="820" MinWidth="1000" MinHeight="700"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{DynamicResource SidebarWidth}"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="18,26,18,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="CloudLight" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
          <TextBlock Text="XiaoMi" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,-2,0,0"/>
          <TextBlock Text="小米设备与家庭 Presence 管理" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Only the device collection scrolls; utility links and footer stay fixed. -->
        <Grid Grid.Row="1" Margin="0,30,0,12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="DevicesNavButton" Content="设备" Command="{Binding ShowDeviceListCommand}" Style="{DynamicResource SidebarButtonStyle}"/>
            <Button x:Name="ToggleDevicesButton" Grid.Column="1" Content="{Binding DevicesToggleGlyph}" Command="{Binding ToggleDevicesCommand}" Style="{DynamicResource SidebarButtonStyle}" Padding="10,8" Margin="0" ToolTip="展开或折叠设备列表"/>
          </Grid>
          <Button x:Name="OverviewNavButton" Grid.Row="1" Content="总览" Command="{Binding ShowDeviceListCommand}" Tag="{Binding IsOverviewActive}" Style="{DynamicResource SidebarSubItemStyle}"/>
          <ScrollViewer x:Name="SidebarDeviceScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <ItemsControl ItemsSource="{Binding SidebarDevices}" Visibility="{Binding IsDevicesExpanded, Converter={StaticResource BooleanToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding OpenCommand}" Tag="{Binding IsActive}" Style="{DynamicResource SidebarDeviceItemStyle}" ToolTip="{Binding SecondaryText}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SubtleBrush}" Margin="1,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock Text="{Binding SecondaryText}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="17,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,18">
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="13,0,13,12"/>
          <Button x:Name="QqNavButton" Content="QQ 提醒" Command="{Binding ShowQqReminderCommand}" Tag="{Binding IsQqReminderActive}" Style="{DynamicResource SidebarButtonStyle}"/>
          <Button x:Name="SettingsNavButton" Content="设置" Command="{Binding ShowSettingsCommand}" Tag="{Binding IsSettingsActive}" Style="{DynamicResource SidebarButtonStyle}"/>
          <Button x:Name="AboutNavButton" Content="关于" Command="{Binding ShowAboutCommand}" Tag="{Binding IsAboutActive}" Style="{DynamicResource SidebarButtonStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
          <TextBlock Text="{Binding ApplicationVersionText, StringFormat=v{0}}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
          <TextBlock Text="CloudLight XiaoMi" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" x:Name="MainContentHost" Margin="0">
      <Grid x:Name="DeviceListPage">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding DataContext.IsXiaomiDeviceListPage, ElementName=MainWindowRoot}" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <ScrollViewer x:Name="DeviceListScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
          <StackPanel Margin="{DynamicResource PagePadding}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="设备" Style="{DynamicResource PageTitleStyle}"/>
                <TextBlock Text="管理 Xiaomi 账号设备、路由器及 Presence 主体。" Style="{DynamicResource PageSubtitleStyle}" Margin="0,7,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Border Style="{DynamicResource StatusBadgeStyle}" Background="{DynamicResource SuccessSoftBrush}">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Xiaomi" Foreground="{DynamicResource SuccessBrush}"/></StackPanel>
                  </Border>
                  <TextBlock Text="{Binding CloudStatus}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,11,0,0">
                  <TextBlock Text="{Binding LastUpdateText, StringFormat=Presence：{0}}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                  <Button Content="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" Style="{DynamicResource SecondaryButton}" Padding="12,6" Margin="12,0,0,0" ToolTip="更新账号设备和路由 Presence"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <Border Style="{DynamicResource CardStyle}" Margin="0,22,0,0" Padding="18">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Xiaomi 账号" Style="{DynamicResource MutedTextStyle}"/><TextBlock Text="{Binding AccountConnectionText}" Style="{DynamicResource CardTitleStyle}" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="当前路由器" Style="{DynamicResource MutedTextStyle}"/>
                  <TextBlock Text="{Binding RouterName}" Style="{DynamicResource CardTitleStyle}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RouterName}"/>
                  <TextBlock Text="{Binding RouterModel}" Foreground="{DynamicResource SubtleBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RouterModel}"/>
                </StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="在线设备" Style="{DynamicResource MutedTextStyle}"/><TextBlock Text="{Binding AccountOnlineCount}" Style="{DynamicResource CardTitleStyle}" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="离线设备" Style="{DynamicResource MutedTextStyle}"/><TextBlock Text="{Binding AccountOfflineCount}" Style="{DynamicResource CardTitleStyle}" Margin="0,5,0,0"/></StackPanel>
              </Grid>
            </Border>

            <Grid Margin="0,22,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button Style="{DynamicResource FilterButton}" Command="{Binding ShowAllCommand}" Tag="{Binding IsAccountAllFilterActive}"><TextBlock><Run Text="全部 "/><Run Text="{Binding AccountAllCount, Mode=OneWay}"/></TextBlock></Button>
                <Button Style="{DynamicResource FilterButton}" Command="{Binding ShowOnlineCommand}" Tag="{Binding IsAccountOnlineFilterActive}"><TextBlock><Run Text="在线 "/><Run Text="{Binding AccountOnlineCount, Mode=OneWay}"/></TextBlock></Button>
                <Button Style="{DynamicResource FilterButton}" Command="{Binding ShowOfflineCommand}" Tag="{Binding IsAccountOfflineFilterActive}"><TextBlock><Run Text="离线 "/><Run Text="{Binding AccountOfflineCount, Mode=OneWay}"/></TextBlock></Button>
                <Button Style="{DynamicResource FilterButton}" Command="{Binding ShowUnknownCommand}" Tag="{Binding IsAccountUnknownFilterActive}"><TextBlock><Run Text="未知 "/><Run Text="{Binding AccountUnknownCount, Mode=OneWay}"/></TextBlock></Button>
              </StackPanel>
              <TextBox Grid.Column="1" Style="{DynamicResource SearchInputStyle}" Text="{Binding AccountSearchText, UpdateSourceTrigger=PropertyChanged}" Tag="搜索设备" ToolTip="搜索设备名称、model、房间或家庭"/>
            </Grid>

            <Border>
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource EmptyStateCardStyle}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding HasAccountDevices}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="没有可显示的 Xiaomi 设备" Style="{DynamicResource CardTitleStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="登录并刷新账号后，已绑定的设备会出现在这里。" Style="{DynamicResource MutedTextStyle}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding AccountDevicesView}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ResponsiveWrapPanel MinItemWidth="310" ItemSpacing="16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border MinHeight="224" Style="{DynamicResource CardHoverStyle}" Margin="0,0,0,16" Cursor="Hand" MouseLeftButtonUp="AccountDeviceCardClicked">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StatusMark}" Foreground="{Binding StatusColor}" FontSize="17" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" Style="{DynamicResource CardTitleStyle}" TextTrimming="CharacterEllipsis"/></StackPanel>
                      <TextBlock Grid.Row="1" Text="{Binding TypeText}" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Row="2" Text="{Binding LocationText}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Row="3" Text="{Binding ModelText}" Foreground="{DynamicResource SubtleBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelText}"/>
                      <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding SecondaryText}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                          <Button Content="查看详情" Command="{Binding OpenCommand}" Style="{DynamicResource SecondaryButton}" FontWeight="SemiBold" Padding="12,7" ToolTip="查看设备信息、属性和操作"/>
                          <Button Content="查看网络设备" Command="{Binding RouterPresenceCommand}" Style="{DynamicResource SecondaryButton}" Padding="11,6" Visibility="{Binding IsRouter, Converter={StaticResource BooleanToVisibility}}"/>
                          <Button Content="{Binding PowerButtonText}" Command="{Binding PowerCommand}" IsEnabled="{Binding CanTogglePower}" Padding="11,6" Visibility="{Binding IsPowerControlVisible, Converter={StaticResource BooleanToVisibility}}"/>
                        </WrapPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,8,0,0">
              <Border Style="{DynamicResource CardStyle}" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" Padding="14" Visibility="{Binding LoginRequired, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal"><Button Content="登录 Xiaomi 账号" Command="{Binding LoginCommand}"/><TextBlock Text="{Binding DiagnosticMessage}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
              </Border>
              <TextBlock Text="{Binding AccountDeviceDiagnostic}" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="设备来自当前 Xiaomi 账号；路由器下的网络设备和 Presence 历史在对应设备页面中管理。" Style="{DynamicResource MutedTextStyle}" Margin="0,5,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <views:RouterPresenceView x:Name="RouterPresencePage" DataContext="{Binding DataContext.CurrentRouterPresence, ElementName=MainWindowRoot}">
        <views:RouterPresenceView.Style>
          <Style TargetType="{x:Type views:RouterPresenceView}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsRouterPresencePage, ElementName=MainWindowRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style>
        </views:RouterPresenceView.Style>
      </views:RouterPresenceView>
      <views:XiaomiAccountDeviceDetailView x:Name="XiaomiAccountDeviceDetailPage" DataContext="{Binding DataContext.CurrentXiaomiAccountDeviceDetail, ElementName=MainWindowRoot}">
        <views:XiaomiAccountDeviceDetailView.Style>
          <Style TargetType="{x:Type views:XiaomiAccountDeviceDetailView}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsXiaomiAccountDeviceDetailPage, ElementName=MainWindowRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style>
        </views:XiaomiAccountDeviceDetailView.Style>
      </views:XiaomiAccountDeviceDetailView>
      <ContentControl x:Name="AuxiliaryPageHost">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding DataContext.IsQqReminderPage, ElementName=MainWindowRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              <DataTrigger Binding="{Binding DataContext.IsSettingsPage, ElementName=MainWindowRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              <DataTrigger Binding="{Binding DataContext.IsAboutPage, ElementName=MainWindowRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              <DataTrigger Binding="{Binding DataContext.IsSubjectDetailPage, ElementName=MainWindowRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              <DataTrigger Binding="{Binding DataContext.IsNetworkDeviceDetailPage, ElementName=MainWindowRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
    </Grid>
  </Grid>
</Window>
