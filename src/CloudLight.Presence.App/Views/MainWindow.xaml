<Window x:Class="CloudLight.Presence.App.Views.MainWindow"
        x:Name="MainWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CloudLight.Presence.App.Views"
        Title="{Binding MainWindowTitle}"
        Icon="/CloudLight.XiaoMi;component/Assets/CloudLightPresence.ico"
        Width="1080" Height="740" MinWidth="700" MinHeight="520"
        Background="#F5F7FB" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid x:Name="DeviceListPage" Margin="32">
      <Grid.Style>
        <Style TargetType="{x:Type Grid}">
          <Setter Property="Visibility" Value="Visible"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsXiaomiDeviceListPage, ElementName=MainWindowRoot}" Value="False">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="CloudLight XiaoMi" FontSize="30" FontWeight="SemiBold" Foreground="#172033"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{Binding AccountConnectionText, StringFormat=账号：{0}}" Foreground="#64748B"/>
            <TextBlock Text=" · " Foreground="#94A3B8"/>
            <TextBlock Text="{Binding AccountDevicesLastUpdateText, StringFormat=最近更新：{0}}" Foreground="#64748B"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="设备" Style="{StaticResource SecondaryButton}" Click="DevicesClicked"/>
            <Button Content="QQ提醒" Style="{StaticResource SecondaryButton}" Click="QqRemindersClicked"/>
            <Button Content="设置" Style="{StaticResource SecondaryButton}" Click="SettingsClicked" Margin="0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,7,0"/>
            <TextBlock Text="Xiaomi" Foreground="#64748B"/>
            <TextBlock Text="{Binding CloudStatus}" Margin="4,0,0,0" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <TextBlock Text="{Binding LastUpdateText, StringFormat=Presence：{0}}" Foreground="#64748B" VerticalAlignment="Center"/>
            <Button Content="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="12,0,0,0" ToolTip="更新账号设备和路由 Presence"/>
          </StackPanel>
          <TextBlock Text="{Binding DiagnosticMessage}" Foreground="#DC2626" HorizontalAlignment="Right" MaxWidth="420" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,20,0,0" Visibility="{Binding LoginRequired, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <Button Content="登录 Xiaomi 账号" Command="{Binding LoginCommand}"/>
          <TextBlock Text="{Binding DiagnosticMessage}" Foreground="#9A3412" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Grid Grid.Row="2" Margin="0,22,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource FilterButton}" Command="{Binding ShowAllCommand}"><TextBlock><Run Text="全部 "/><Run Text="{Binding AccountAllCount, Mode=OneWay}"/></TextBlock></Button>
          <Button Style="{StaticResource FilterButton}" Command="{Binding ShowOnlineCommand}"><TextBlock><Run Text="在线 "/><Run Text="{Binding AccountOnlineCount, Mode=OneWay}"/></TextBlock></Button>
          <Button Style="{StaticResource FilterButton}" Command="{Binding ShowOfflineCommand}"><TextBlock><Run Text="离线 "/><Run Text="{Binding AccountOfflineCount, Mode=OneWay}"/></TextBlock></Button>
          <Button Style="{StaticResource FilterButton}" Command="{Binding ShowUnknownCommand}"><TextBlock><Run Text="未知 "/><Run Text="{Binding AccountUnknownCount, Mode=OneWay}"/></TextBlock></Button>
        </StackPanel>
        <TextBox Grid.Column="1" Text="{Binding AccountSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索设备名称、model、房间或家庭"/>
      </Grid>

      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding AccountDevicesView}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="310" MinHeight="224" Padding="20" Margin="0,0,16,16">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
                    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#AFC0F6"/><Setter Property="Background" Value="#FAFBFF"/></Trigger></Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StatusMark}" Foreground="{Binding StatusColor}" FontSize="17" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="245"/></StackPanel>
                  <TextBlock Grid.Row="1" Text="{Binding TypeText}" Foreground="#475569" Margin="0,10,0,0"/>
                  <TextBlock Grid.Row="2" Text="{Binding LocationText}" Foreground="#64748B" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="3" Text="{Binding ModelText}" Foreground="#94A3B8" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                  <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="{Binding SecondaryText}" Foreground="#64748B" Margin="0,5,0,0"/></StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                      <Button Content="查看详情" Command="{Binding OpenCommand}" Style="{StaticResource SecondaryButton}" FontWeight="SemiBold" Padding="12,7" ToolTip="查看设备信息、属性和操作"/>
                      <Button Content="查看网络设备" Command="{Binding RouterPresenceCommand}" Style="{StaticResource SecondaryButton}" Padding="11,6" Visibility="{Binding IsRouter, Converter={StaticResource BooleanToVisibility}}"/>
                      <Button Content="{Binding PowerButtonText}" Command="{Binding PowerCommand}" IsEnabled="{Binding CanTogglePower}" Padding="11,6" Visibility="{Binding IsPowerControlVisible, Converter={StaticResource BooleanToVisibility}}"/>
                    </WrapPanel>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Grid.Row="4">
        <TextBlock Text="{Binding AccountDeviceDiagnostic}" Foreground="#B45309" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="设备来自当前 Xiaomi 账号；路由器下的网络设备和 Presence 历史在路由器 Presence 页面中管理。" Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>

    <views:RouterPresenceView x:Name="RouterPresencePage"
                              DataContext="{Binding DataContext.CurrentRouterPresence, ElementName=MainWindowRoot}">
      <views:RouterPresenceView.Style>
        <Style TargetType="{x:Type views:RouterPresenceView}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsRouterPresencePage, ElementName=MainWindowRoot}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </views:RouterPresenceView.Style>
    </views:RouterPresenceView>
    <views:XiaomiAccountDeviceDetailView x:Name="XiaomiAccountDeviceDetailPage"
                                          DataContext="{Binding DataContext.CurrentXiaomiAccountDeviceDetail, ElementName=MainWindowRoot}">
      <views:XiaomiAccountDeviceDetailView.Style>
        <Style TargetType="{x:Type views:XiaomiAccountDeviceDetailView}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsXiaomiAccountDeviceDetailPage, ElementName=MainWindowRoot}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </views:XiaomiAccountDeviceDetailView.Style>
    </views:XiaomiAccountDeviceDetailView>
  </Grid>
</Window>
