<Window x:Class="CloudLight.Presence.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloudLight XiaoMi" Icon="/CloudLight.XiaoMi;component/Assets/CloudLightPresence.ico" Width="1080" Height="740" MinWidth="700" MinHeight="520" Background="#F5F7FB" WindowStartupLocation="CenterScreen">
  <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="CloudLight XiaoMi" FontSize="30" FontWeight="SemiBold" Foreground="#172033"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding RouterSummary}" Foreground="#64748B"/><ComboBox Width="210" Height="30" ItemsSource="{Binding Routers}" SelectedItem="{Binding SelectedRouter}" DisplayMemberPath="Name" Margin="12,0,0,0" Visibility="{Binding HasMultipleRouters, Converter={StaticResource BooleanToVisibility}}"/></StackPanel></StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right"><Button Content="设置" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="SettingsClicked"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,7,0"/><TextBlock Text="连接" Foreground="#64748B"/><TextBlock Text="{Binding CloudStatus}" Margin="4,0,0,0" FontWeight="SemiBold"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0"><TextBlock Text="{Binding LastUpdateText, StringFormat=最近更新：{0}}" Foreground="#64748B" VerticalAlignment="Center"/><Button Content="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="12,0,0,0" ToolTip="立即从云端更新设备状态"/></StackPanel><TextBlock Text="{Binding DiagnosticMessage}" Foreground="#DC2626" HorizontalAlignment="Right" MaxWidth="420" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,20,0,0" Visibility="{Binding LoginRequired, Converter={StaticResource BooleanToVisibility}}"><StackPanel Orientation="Horizontal"><Button Content="登录 Xiaomi 账号" Command="{Binding LoginCommand}"/><TextBlock Text="{Binding DiagnosticMessage}" Foreground="#9A3412" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel></Border>
    <Grid Grid.Row="2" Margin="0,22,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button Style="{StaticResource FilterButton}" Command="{Binding ShowAllCommand}"><TextBlock><Run Text="全部 "/><Run Text="{Binding AllCount, Mode=OneWay}"/></TextBlock></Button><Button Style="{StaticResource FilterButton}" Command="{Binding ShowOnlineCommand}"><TextBlock><Run Text="在线 "/><Run Text="{Binding OnlineCount, Mode=OneWay}"/></TextBlock></Button><Button Style="{StaticResource FilterButton}" Command="{Binding ShowOfflineCommand}"><TextBlock><Run Text="离线 "/><Run Text="{Binding OfflineCount, Mode=OneWay}"/></TextBlock></Button><Button Style="{StaticResource FilterButton}" Command="{Binding ShowUnknownCommand}"><TextBlock><Run Text="未知 "/><Run Text="{Binding UnknownCount, Mode=OneWay}"/></TextBlock></Button></StackPanel>
      <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索名称、备注、关联设备、MAC 或 IP"/>
    </Grid>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding CardsView}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Button Command="{Binding OpenCommand}" Background="Transparent" Foreground="#172033" Padding="0" Margin="0,0,16,16" ToolTip="{Binding Secondary}" HorizontalContentAlignment="Stretch"><Border Width="300" MinHeight="174" Padding="20"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#AFC0F6"/><Setter Property="Background" Value="#FAFBFF"/></Trigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StateMark}" Foreground="{Binding StateColor}" FontSize="17" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="235"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,19,0,18"><TextBlock Text="{Binding Duration}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentConnection}" Foreground="#64748B" Margin="0,7,0,0"/></StackPanel>
        <TextBlock Grid.Row="2" Text="{Binding Secondary}" Foreground="#475569"/>
      </Grid></Border></Button>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <TextBlock Grid.Row="4" Text="{Binding DiagnosticMessage}" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
