<UserControl x:Class="CloudLight.Presence.App.Views.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel Margin="{DynamicResource PagePadding}">
      <TextBlock Text="设置" Style="{DynamicResource PageTitleStyle}"/>
      <TextBlock Text="配置 CloudLight XiaoMi 的运行和监控行为。" Style="{DynamicResource PageSubtitleStyle}" Margin="0,7,0,0"/>

      <TextBlock Text="常规" Style="{DynamicResource SectionTitleStyle}" Margin="0,26,0,11"/>
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel>
          <TextBlock Text="应用行为" Style="{DynamicResource CardTitleStyle}"/>
          <CheckBox x:Name="StartWithWindowsBox" Content="开机自动启动 CloudLight XiaoMi" Style="{DynamicResource ToggleSwitchStyle}" Checked="GeneralSettingChanged" Unchecked="GeneralSettingChanged" Margin="0,14,0,0"/>
          <CheckBox x:Name="StartMinimizedBox" Content="启动后最小化到托盘" Style="{DynamicResource ToggleSwitchStyle}" Checked="GeneralSettingChanged" Unchecked="GeneralSettingChanged" Margin="0,14,0,0"/>
          <TextBlock x:Name="GeneralStatus" Style="{DynamicResource MutedTextStyle}" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Presence" Style="{DynamicResource SectionTitleStyle}" Margin="0,26,0,11"/>
      <Border Style="{DynamicResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="当前路由器" Style="{DynamicResource MutedTextStyle}"/>
          <TextBlock Grid.Column="1" Text="{Binding RouterSummary}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Row="1" Text="轮询间隔" Style="{DynamicResource MutedTextStyle}" Margin="0,16,0,0" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="PollingIntervalBox" Style="{DynamicResource NumericInputStyle}" Width="88" TextAlignment="Right" PreviewTextInput="PollingIntervalPreviewTextInput"/>
            <TextBlock Text="秒" VerticalAlignment="Center" Margin="8,0,12,0"/>
            <Button Content="应用" Style="{DynamicResource SecondaryButtonStyle}" Padding="12,6" Click="ApplyPollingIntervalClicked"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
            <TextBlock Text="设备状态会按照设置的时间自动更新。" Style="{DynamicResource MutedTextStyle}"/>
            <TextBlock Text="推荐使用 10 秒或更长的刷新间隔。过短的间隔会增加网络请求。" Style="{DynamicResource MutedTextStyle}"/>
            <TextBlock x:Name="PollingStatus" Foreground="{DynamicResource SuccessBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <TextBlock Grid.Row="3" Text="Xiaomi 状态" Style="{DynamicResource MutedTextStyle}" Margin="0,16,0,0"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CloudStatus}" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,0"/>
        </Grid>
      </Border>

      <TextBlock Text="数据" Style="{DynamicResource SectionTitleStyle}" Margin="0,26,0,11"/>
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel>
          <TextBlock Text="数据目录" Style="{DynamicResource CardTitleStyle}"/>
          <TextBlock x:Name="DataPathText" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <WrapPanel>
            <Button Content="导出数据" Click="ExportClicked" Style="{DynamicResource PrimaryButtonStyle}"/>
            <Button Content="导入数据" Style="{DynamicResource SecondaryButtonStyle}" Click="ImportClicked"/>
            <Button Content="打开数据目录" Style="{DynamicResource SecondaryButtonStyle}" Click="OpenDataDirectoryClicked" Margin="0"/>
          </WrapPanel>
          <TextBlock x:Name="DataStatus" Style="{DynamicResource MutedTextStyle}" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>

      <TextBlock Text="诊断" Style="{DynamicResource SectionTitleStyle}" Margin="0,26,0,11"/>
      <Border Style="{DynamicResource CardStyle}">
        <StackPanel>
          <TextBlock Text="运行状态" Style="{DynamicResource CardTitleStyle}" Margin="0,0,0,10"/>
          <TextBlock Text="{Binding Diagnostics}" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
