<Window x:Class="CloudLight.Presence.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · CloudLight XiaoMi" Icon="/CloudLight.XiaoMi;component/Assets/CloudLightPresence.ico" Width="760" Height="900" MinHeight="650" Background="#F5F7FB" WindowStartupLocation="CenterOwner" Loaded="WindowLoaded">
  <Window.Resources>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Foreground" Value="#B42318"/><Setter Property="Background" Value="#FEF0EF"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FEE2E0"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
    <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/>
    <TextBlock Text="常规" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
    <Border Style="{StaticResource SurfaceCard}"><StackPanel>
      <CheckBox x:Name="StartWithWindowsBox" Content="开机自动启动 CloudLight XiaoMi" Checked="GeneralSettingChanged" Unchecked="GeneralSettingChanged"/>
      <CheckBox x:Name="StartMinimizedBox" Content="启动后最小化到托盘" Margin="0,14,0,0" Checked="GeneralSettingChanged" Unchecked="GeneralSettingChanged"/>
      <TextBlock x:Name="GeneralStatus" Foreground="#64748B" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <TextBlock Text="监控" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
    <Border Style="{StaticResource SurfaceCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="当前路由器" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding RouterSummary}"/>
      <TextBlock Grid.Row="1" Text="自动刷新间隔" Foreground="#64748B" Margin="0,14,0,0" VerticalAlignment="Center"/>
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0"><TextBox x:Name="PollingIntervalBox" Width="76" TextAlignment="Right" PreviewTextInput="PollingIntervalPreviewTextInput"/><TextBlock Text="秒" VerticalAlignment="Center" Margin="8,0,12,0"/><Button Content="应用" Style="{StaticResource SecondaryButton}" Padding="12,5" Click="ApplyPollingIntervalClicked"/></StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"><TextBlock Text="设备状态会按照设置的时间自动更新。" Foreground="#64748B"/><TextBlock Text="推荐使用 10 秒或更长的刷新间隔。过短的间隔会增加网络请求。" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock x:Name="PollingStatus" Foreground="#16A34A" Margin="0,5,0,0"/></StackPanel>
      <TextBlock Grid.Row="3" Text="Xiaomi 连接" Foreground="#64748B" Margin="0,14,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CloudStatus}" Margin="0,14,0,0"/>
    </Grid></Border>
    <TextBlock Text="通知" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
    <Border Style="{StaticResource SurfaceCard}"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="QQ 通知" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="状态：" Foreground="#64748B"/><TextBlock Text="{Binding Notifications.QqStatusText}" FontWeight="SemiBold"/><TextBlock Text=" · " Foreground="#94A3B8"/><TextBlock Text="{Binding Notifications.QqStatusDetail}" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="350"/></StackPanel><TextBlock Text="{Binding Notifications.QqSecretText, StringFormat=应用密钥：{0}}" Foreground="#64748B" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="配置 QQ" Click="ConfigureQqClicked"/><Button Content="发送测试消息" Style="{StaticResource SecondaryButton}" Click="SendTestMessageClicked"/></StackPanel>
      </Grid>
      <TextBlock Text="使用 QQ 官方开放平台 Bot；私聊和群聊目标填写 OpenID，不会把认证密钥写入设置或导出文件。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,14,0,0"/>
      <TextBlock Text="{Binding Notifications.OperationStatus}" Foreground="#16803A" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Border Background="#F8FAFC" BorderBrush="#E4E9F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,0"><StackPanel>
        <TextBlock Text="连接异常提醒" FontSize="15" FontWeight="SemiBold"/>
        <CheckBox x:Name="ConnectionAlertEnabledBox" Content="Xiaomi 服务连接失败时通知" Margin="0,10,0,0"/>
        <CheckBox x:Name="ConnectionAlertRecoveryBox" Content="恢复连接时通知" Margin="0,8,0,0"/>
        <CheckBox x:Name="ConnectionAlertUseDefaultBox" Content="使用 QQ 配置中的默认接收目标" Margin="0,8,0,0" Checked="ConnectionAlertTargetModeChanged" Unchecked="ConnectionAlertTargetModeChanged"/>
        <Grid x:Name="ConnectionAlertTargetGrid" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="发送到" Foreground="#64748B" VerticalAlignment="Center"/><ComboBox x:Name="ConnectionAlertTargetTypeBox" Grid.Column="1" SelectionChanged="ConnectionAlertTargetChanged"><ComboBoxItem Content="QQ 私聊" Tag="Private"/><ComboBoxItem Content="QQ群聊" Tag="Group"/></ComboBox><StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock x:Name="ConnectionAlertTargetLabel" Text="用户 OpenID" Foreground="#64748B" Margin="0,0,0,4"/><TextBox x:Name="ConnectionAlertTargetIdBox" ToolTip="不是普通 QQ 号，例如不要填写 123456789"/></StackPanel></Grid>
        <TextBlock x:Name="ConnectionAlertTargetHint" Foreground="#64748B" TextWrapping="Wrap" Margin="130,8,0,0"/>
        <Button Content="保存连接提醒设置" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="SaveConnectionAlertClicked" Padding="12,6"/>
      </StackPanel></Border>
    </StackPanel></Border>
    <DockPanel Margin="0,24,0,10"><TextBlock Text="自动提醒" Style="{StaticResource SectionTitle}"/><Button DockPanel.Dock="Right" Content="＋ 添加提醒" Click="AddRuleClicked" Padding="12,6"/></DockPanel>
    <Border Style="{StaticResource SurfaceCard}"><StackPanel>
      <ItemsControl ItemsSource="{Binding Notifications.Rules}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="#E4E9F0" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel>
          <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding MessagePreview}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="{Binding ToggleText}" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding}" Click="ToggleRuleClicked" Padding="10,5"/><Button Content="编辑" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding}" Click="EditRuleClicked" Padding="10,5"/><Button Content="删除" Style="{StaticResource DangerButton}" CommandParameter="{Binding}" Click="DeleteRuleClicked" Padding="10,5"/></StackPanel></Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="暂无自动提醒。" Foreground="#94A3B8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Notifications.HasRules}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel></Border>
    <TextBlock Text="最近通知" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
    <Border Style="{StaticResource SurfaceCard}"><StackPanel>
      <ItemsControl ItemsSource="{Binding Notifications.RecentDeliveries}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CreatedText}" Foreground="#64748B"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding SubjectName}" FontWeight="SemiBold"/><TextBlock Text="{Binding MessageText}" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorText}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" HorizontalAlignment="Right"/><TextBlock Text="{Binding TargetText}" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ItemsControl ItemsSource="{Binding Notifications.RecentSystemDeliveries}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CreatedText}" Foreground="#64748B"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding SubjectName}" FontWeight="SemiBold"/><TextBlock Text="{Binding MessageText}" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorText}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" HorizontalAlignment="Right"/><TextBlock Text="{Binding TargetText}" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="暂无通知记录。" Foreground="#94A3B8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Notifications.HasAnyRecentDeliveries}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel></Border>
    <TextBlock Text="数据" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
    <Border Style="{StaticResource SurfaceCard}"><StackPanel><TextBlock Text="数据目录" Foreground="#64748B"/><TextBlock x:Name="DataPathText" Margin="0,5,0,10" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button Content="导出数据" Click="ExportClicked"/><Button Content="导入数据" Style="{StaticResource SecondaryButton}" Click="ImportClicked"/><Button Content="打开数据目录" Style="{StaticResource SecondaryButton}" Click="OpenDataDirectoryClicked"/></StackPanel><TextBlock x:Name="DataStatus" Foreground="#64748B" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    <TextBlock Text="诊断" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
    <Border Style="{StaticResource SurfaceCard}"><TextBlock Text="{Binding Diagnostics}" FontFamily="Consolas" Foreground="#475569" TextWrapping="Wrap"/></Border>
  </StackPanel></ScrollViewer>
</Window>
