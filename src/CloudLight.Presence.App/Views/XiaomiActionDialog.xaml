<Window x:Class="CloudLight.Presence.App.Views.XiaomiActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="执行设备操作" Width="560" MinWidth="460" SizeToContent="Height"
        MaxHeight="760" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" MaxHeight="620" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
      <StackPanel>
        <TextBlock Text="{Binding DisplayName, StringFormat=执行“{0}”}" Style="{DynamicResource DialogTitleStyle}" TextWrapping="Wrap"/>
        <TextBlock Text="确认参数后，操作会直接发送到当前 Xiaomi 设备。" Style="{DynamicResource DialogSubtitleStyle}" Margin="0,7,0,0"/>
        <Border Grid.Row="1" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,18,0,14" Visibility="{Binding RequiresConfirmation, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <TextBlock Text="高风险操作" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
            <TextBlock Text="{Binding RiskWarning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource DialogCardStyle}">
          <StackPanel>
            <TextBlock Text="操作参数" Style="{DynamicResource SectionTitleStyle}" Margin="0,0,0,16"/>
            <ItemsControl ItemsSource="{Binding InputArguments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="必填" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,4,0,0" Visibility="{Binding IsRequired, Converter={StaticResource BooleanToVisibility}}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="开启" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding BoolValue, Mode=TwoWay}" Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibility}}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ValueOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedOption, Mode=TwoWay}" Style="{DynamicResource ComboBoxStyle}" Visibility="{Binding IsEnum, Converter={StaticResource BooleanToVisibility}}"/>
                    <StackPanel Grid.Column="1" Visibility="{Binding IsNumber, Converter={StaticResource BooleanToVisibility}}">
                      <Slider Minimum="{Binding MinimumDouble}" Maximum="{Binding MaximumDouble}" Value="{Binding SliderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSnapToTickEnabled="True"/>
                      <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding SliderText}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UnitText}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
                      </StackPanel>
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle}" VerticalContentAlignment="Top" Visibility="{Binding IsTextFallback, Converter={StaticResource BooleanToVisibility}}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ErrorText" Style="{DynamicResource DialogErrorStyle}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" Style="{DynamicResource SecondaryButtonStyle}" Click="CancelClicked"/>
      <Button Content="执行" Click="ExecuteClicked" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>
